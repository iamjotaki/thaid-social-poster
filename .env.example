# ==========================================
# LIVERPOOL FC AUTO NEWS BOT CONFIGURATION
# ==========================================

# 1. Google Gemini API Key (ขอฟรีได้ที่ https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Facebook Page Configuration (ขอได้ที่ https://developers.facebook.com/)
# หากยังไม่มี ให้เปิด DRY_RUN=true ไว้ก่อนเพื่อทดสอบดูดข่าวและเขียนโพสต์ลงเครื่อง
FB_PAGE_ID=your_page_id_here
FB_PAGE_ACCESS_TOKEN=your_page_access_token_here

# 3. Mode Settings
# DRY_RUN=true: ทดสอบดึงข่าวและให้ AI เขียนลงไฟล์พรีวิว HTML/JSON โดยยังไม่โพสต์จริงขึ้น Facebook
# DRY_RUN=false: โพสต์จริงขึ้น Facebook Page ทันที
DRY_RUN=true

# 4. Interval (นาที) สำหรับโหมดรันวนอัตโนมัติ
CHECK_INTERVAL_MINUTES=30
